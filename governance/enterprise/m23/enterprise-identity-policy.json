{
  "version": "0.23.0",
  "milestone": "M23",
  "title": "Enterprise Identity, MFA & PAM",
  "federation": {
    "protocol": "OIDC",
    "token_validation_profile": "signed-claims with issuer/audience/subject/iat/exp/auth_time validation",
    "allowed_signature_profile_for_offline_validation": "EdDSA",
    "production_note": "Production deployments SHALL trust only configured enterprise IdP signing keys/JWKS and SHALL NOT use validation-only private keys generated by M23 scripts."
  },
  "mfa": {
    "required_for_human_access": true,
    "privileged_phishing_resistant_required": true,
    "required_acr": "urn:studioraga:aal2",
    "phishing_resistant_methods": ["webauthn", "fido2", "piv", "smartcard", "hwk"],
    "non_phishing_resistant_examples": ["otp", "sms", "email"],
    "max_auth_age_sec": 43200
  },
  "entitlements": {
    "default_deny": true,
    "least_privilege": true,
    "resource_scoped": true,
    "expiry_required": true,
    "owner_required": true,
    "review_interval_days": 90
  },
  "pam": {
    "jit_required_for_privileged_actions": true,
    "jit_max_ttl_sec": 3600,
    "single_use_grants": true,
    "independent_approver_required": true,
    "session_evidence_required": true,
    "break_glass": {
      "maximum_ttl_sec": 900,
      "minimum_independent_approvers": 2,
      "reason_required": true,
      "post_review_required": true,
      "single_use": true
    }
  },
  "segregation_of_duties": {
    "self_approval_forbidden": true,
    "subject_cannot_be_break_glass_approver": true,
    "distinct_break_glass_approvers": true
  },
  "claim_boundaries": {
    "cissp_certification_claim": false,
    "iso_iec_27001_certification_claim": false,
    "iso_iec_42001_certification_claim": false,
    "cra_conformity_claim": false
  }
}
