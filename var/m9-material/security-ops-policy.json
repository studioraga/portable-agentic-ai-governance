{
  "containment_rules": [
    {
      "action": "model.quarantine.local",
      "event_types": [
        "model.integrity.failure",
        "model.policy.violation"
      ],
      "rule_id": "SECOPS-CRITICAL-MODEL",
      "severities": [
        "critical"
      ]
    },
    {
      "action": "workload.isolate.local",
      "event_types": [
        "workload.identity.compromise",
        "agent.policy.bypass"
      ],
      "rule_id": "SECOPS-CRITICAL-WORKLOAD",
      "severities": [
        "critical"
      ]
    }
  ],
  "evidence_max_bytes": 10485760,
  "external_side_effects": false,
  "incident_severities": [
    "high",
    "critical"
  ],
  "llm_decision_authority": false,
  "m8_external_action_boundary": true,
  "purpose": "Deterministic security operations",
  "recovery": {
    "all_checks_required": true,
    "authorization_ttl_max_seconds": 900,
    "automatic_recovery": false,
    "evidence_verification_required": true,
    "operator_required": true,
    "operators": [
      "HUMAN-RESPONDER-001"
    ]
  },
  "siem": {
    "append_only": true,
    "hash_chain": true,
    "max_event_age_seconds": 86400,
    "max_future_skew_seconds": 60
  },
  "version": "0.9.0"
}
