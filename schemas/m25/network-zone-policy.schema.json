{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "default_decision",
    "zones",
    "flows"
  ],
  "properties": {
    "default_decision": {
      "const": "deny"
    },
    "zones": {
      "type": "array",
      "minItems": 1
    },
    "flows": {
      "type": "array"
    }
  }
}
