{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "case_id": {
      "type": "string"
    },
    "case_type": {
      "enum": [
        "AEV",
        "SEVERE_INCIDENT"
      ]
    },
    "human_submission_required": {
      "const": true
    },
    "pack_id": {
      "type": "string"
    },
    "srp_submission_performed": {
      "const": false
    },
    "stages": {
      "minItems": 3,
      "type": "array"
    }
  },
  "required": [
    "pack_id",
    "case_id",
    "case_type",
    "stages",
    "srp_submission_performed",
    "human_submission_required"
  ],
  "title": "M14 CRA reporting evidence pack",
  "type": "object"
}
