{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PAG M2 Workload Registry",
  "type": "object",
  "required": ["workloads"],
  "properties": {
    "workloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["uri", "principal_id", "roles"],
        "properties": {
          "uri": {"type": "string", "pattern": "^spiffe://"},
          "principal_id": {"type": "string", "minLength": 1},
          "roles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "attributes": {"type": "object", "additionalProperties": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
