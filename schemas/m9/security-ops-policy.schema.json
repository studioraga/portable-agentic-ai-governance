{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PAG M9 Security Operations Policy",
  "type": "object",
  "required": ["version","incident_severities","containment_rules","recovery","evidence_max_bytes","llm_decision_authority","external_side_effects","m8_external_action_boundary"],
  "properties": {
    "version": {"const": "0.9.0"},
    "incident_severities": {"type":"array","items":{"enum":["high","critical"]},"uniqueItems":true},
    "containment_rules": {"type":"array","minItems":1},
    "recovery": {"type":"object"},
    "evidence_max_bytes": {"type":"integer","minimum":1},
    "llm_decision_authority": {"const": false},
    "external_side_effects": {"const": false},
    "m8_external_action_boundary": {"const": true}
  },
  "additionalProperties": true
}
