{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "grant", "signature"],
  "properties": {
    "schema": {"const": "pag-m8-signed-approval-v1"},
    "signature": {"type": "string", "minLength": 1, "maxLength": 256},
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_id", "request_sha256", "tool_name", "resource", "requester", "approver", "arguments_sha256", "issued_at", "expires_at", "max_uses"],
      "properties": {
        "approval_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tool_name": {"type": "string", "enum": ["incident.create", "rerun.request", "ticket.create", "model.quarantine"]},
        "resource": {"type": "string", "pattern": "^action://"},
        "requester": {"type": "string", "minLength": 1, "maxLength": 128},
        "approver": {"type": "string", "minLength": 1, "maxLength": 128},
        "arguments_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "issued_at": {"type": "integer", "minimum": 0},
        "expires_at": {"type": "integer", "minimum": 1},
        "max_uses": {"const": 1}
      }
    }
  }
}
